node_modules/
dist/
data/

# Секреты окружения. В гите только `.env.example` — имена переменных без значений
.env
.env.*
!.env.example

# Приватные ключи рядом с корневым сертификатом провайдера. Сам CA (`*.crt`)
# остаётся в гите: без него не встаёт `sslmode=verify-full`
certs/*.key
certs/*.pem
certs/*.p12
certs/*.pfx

*.db
*.db-wal
*.db-shm

# Дампы базы (перенос региона, бэкапы): ПД, хэши сессий и зашифрованные токены.
# Миграции `drizzle/*.sql` под правило не попадают — они не дампы
*.dump
*.sql.gz
*.bak

# Логи: в них оседают тела запросов и URL с токенами приглашений (S9)
*.log
npm-debug.log*
logs/

# Артефакты прогонов: пересоздаются командами, в гите не нужны
coverage/
*.tsbuildinfo

# Локальные скиллы разработчика: инструмент рабочего места, не код проекта
.claude/skills/
# Личные разрешения Claude Code: у каждого свои
.claude/settings.local.json
# Состояние сессий superpowers
.superpowers/

# Редакторы и мусор ОС
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
