NODE_ENV=development
PORT=3000
# Строка подключения к облачному Postgres. Обязательна, значения по умолчанию нет.
# Соединение обязано идти по TLS: sslmode=require — часть строки, отдельной переменной нет
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Meta / Instagram
META_APP_SECRET=
META_VERIFY_TOKEN=

# 32 байта в hex. Сгенерировать:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIALS_ENC_KEY=

# TikTok (необязательно на старте)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_POLL_INTERVAL_SEC=120

THROTTLE_MAX_REPLIES_PER_MINUTE=6
THROTTLE_MAX_REPLIES_PER_CLIENT_PER_MINUTE=60
MAX_INCOMING_TEXT_LENGTH=2000

# Воркер: как часто разгребать очереди и сколько раз повторять отправку
WORKER_INTERVAL_MS=2000
OUTBOX_MAX_ATTEMPTS=8
# На столько секунд строка outbox уходит из видимости других копий процесса
OUTBOX_LEASE_SEC=60
FILES_DIR=./data/files

# Вход и сессии
SESSION_SECRET=смените-на-случайную-строку-не-короче-32-символов
SESSION_TTL_DAYS=7
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# Основа ссылки приглашения, без завершающего слэша
PUBLIC_BASE_URL=http://localhost:3000
INVITE_TTL_HOURS=48
