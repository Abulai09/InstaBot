NODE_ENV=development
PORT=3000
DATABASE_URL=./data/bot.db

# Meta / Instagram
META_APP_SECRET=
META_VERIFY_TOKEN=
IG_PAGE_ACCESS_TOKEN=

# 32 байта в hex. Сгенерировать:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIALS_ENC_KEY=

# TikTok (необязательно на старте)
