NODE_ENV=development
PORT=3000
# Число прокси перед процессом: 0 локально, 1 за балансировщиком Render.
# Больше, чем прокси на самом деле, ставить нельзя — адрес станет подделываемым
TRUST_PROXY_HOPS=0
# Строка подключения к облачному Postgres. Обязательна, значения по умолчанию нет.
# Вставляется как есть из Supabase: Connect -> Direct -> Session pooler.
#
# Шифрование и проверку сервера (sslmode=verify-full по сертификату из certs/)
# код включает сам — src/storage/tls.ts. Явный sslmode в строке имеет приоритет,
# локальная база (localhost) остаётся без TLS.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Meta / Instagram
META_APP_SECRET=
META_VERIFY_TOKEN=

# 32 байта в hex. Сгенерировать:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIALS_ENC_KEY=

# TikTok (необязательно на старте)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_POLL_INTERVAL_SEC=120

THROTTLE_MAX_REPLIES_PER_MINUTE=6
THROTTLE_MAX_REPLIES_PER_CLIENT_PER_MINUTE=60
MAX_INCOMING_TEXT_LENGTH=2000

# Воркер: как часто разгребать очереди и сколько раз повторять отправку
WORKER_INTERVAL_MS=2000
OUTBOX_MAX_ATTEMPTS=8
# На столько секунд строка outbox уходит из видимости других копий процесса.
# Не меньше 60: вдвое больше таймаута запроса к платформе (30 с)
OUTBOX_LEASE_SEC=60
FILES_DIR=./data/files

# Вход и сессии
# Пусто, как и остальные секреты: заполненная заглушка прошла бы проверку длины,
# и забывший её сервис работал бы на секрете, опубликованном в репозитории.
# Сгенерировать:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
SESSION_TTL_DAYS=7
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# Основа ссылки приглашения, без завершающего слэша
PUBLIC_BASE_URL=http://localhost:3000
INVITE_TTL_HOURS=48
