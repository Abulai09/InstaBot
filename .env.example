TIKTOK_CLIENT_SECRET=
TIKTOK_POLL_INTERVAL_SEC=120

# Уведомление оператора (необязательно)
OPERATOR_TELEGRAM_BOT_TOKEN=
OPERATOR_TELEGRAM_CHAT_ID=

THROTTLE_MAX_REPLIES_PER_MINUTE=6
MAX_INCOMING_TEXT_LENGTH=2000
